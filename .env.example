# ═══════════════════════════════════════════════════════════════
# Ross House Rentals - Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy to .env and fill in your values

# MongoDB Atlas
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/taxportal?retryWrites=true&w=majority
DB_NAME=taxportal

# JWT / session security
# TENANT_JWT_SECRET signs marketplace/tenant JWTs and MUST be a long random secret.
TENANT_JWT_SECRET=replace-with-a-long-random-secret
JWT_SECRET_KEY=your-secret-key-here
JWT_SECRET=your-secret-key-here

# Refresh-token rollout (safe defaults preserve current production behavior)
REFRESH_TOKENS_ENABLED=false
ALLOW_LEGACY_USER_SESSIONS=true
REQUIRE_SESSION_SID=false
# Recommended dedicated HMAC derivation secret for refresh-token rotation.
# Generate independently from TENANT_JWT_SECRET. Never commit the real value.
REFRESH_DERIVE_KEY=replace-with-an-independent-long-random-secret

# Stripe (Payments)
STRIPE_API_KEY=sk_live_your_key_here
STRIPE_SECRET_KEY=sk_live_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_live_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Twilio (SMS / OTP)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+18065914974

# SendGrid (Email)
SENDGRID_API_KEY=SG.your_sendgrid_key
SENDGRID_FROM_EMAIL=info@rosshouserentals.com

# Port (Railway sets this automatically)
# PORT=8001


# Core climate integration. Safe production default: disabled until explicitly activated.
CLIMATE_ENABLED=false
CLIMATE_CONTROL_ENABLED=false
CLIMATE_TOKEN_KEY=replace-with-a-production-fernet-key
CLIMATE_RESIDEO_CLIENT_ID=
CLIMATE_RESIDEO_CLIENT_SECRET=
CLIMATE_REDIRECT_URI=
# Total Connect Comfort (TCC US) credentials are entered only through Admin > Climatización
# and are encrypted at rest; never place the thermostat username/password in env files.

# NOAA/NWS Weather Intelligence (open US Government data; no API key)
CLIMATE_WEATHER_ENABLED=false
CLIMATE_WEATHER_CACHE_MINUTES=10
NWS_USER_AGENT=RossHouseRentals/1.0 (https://rosshouserentals.com)

# Independent climate workers.
# Read-only telemetry may run in staging without enabling general background jobs.
CLIMATE_TELEMETRY_ENABLED=false
CLIMATE_TELEMETRY_INTERVAL_SECONDS=300
CLIMATE_READ_RETRY_COUNT=1
CLIMATE_READ_RETRY_DELAY_SECONDS=1
# Automatic schedule execution can write to thermostats and requires explicit opt-in.
CLIMATE_SCHEDULE_WORKER_ENABLED=false
CLIMATE_SCHEDULE_INTERVAL_SECONDS=60
# Legacy compatibility: CLIMATE_MONITOR_ENABLED=true enables telemetry only.

# Climate notifications are independently gated from telemetry and thermostat control.
CLIMATE_ALERT_NOTIFICATIONS_ENABLED=false
CLIMATE_ALERT_PUSH_ENABLED=false
CLIMATE_ALERT_NOTIFY_ADMINS=false

# Optional NOAA/NCEI historical weather token is managed from Admin > Configuración > NOAA/NCEI.
# Do not place NCEI_CDO_TOKEN in client env files or commit it to Git.
