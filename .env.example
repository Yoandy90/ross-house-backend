# ═══════════════════════════════════════════════════════════════
# Ross House Rentals - Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy to .env and fill in your values

# MongoDB Atlas
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/taxportal?retryWrites=true&w=majority
DB_NAME=taxportal

# JWT / session security
# TENANT_JWT_SECRET signs marketplace/tenant JWTs and MUST be a long random secret.
TENANT_JWT_SECRET=replace-with-a-long-random-secret
JWT_SECRET_KEY=your-secret-key-here
JWT_SECRET=your-secret-key-here

# Refresh-token rollout (safe defaults preserve current production behavior)
REFRESH_TOKENS_ENABLED=false
ALLOW_LEGACY_USER_SESSIONS=true
REQUIRE_SESSION_SID=false
# Recommended dedicated HMAC derivation secret for refresh-token rotation.
# Generate independently from TENANT_JWT_SECRET. Never commit the real value.
REFRESH_DERIVE_KEY=replace-with-an-independent-long-random-secret

# Stripe (Payments)
STRIPE_API_KEY=sk_live_your_key_here
STRIPE_SECRET_KEY=sk_live_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_live_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Twilio (SMS / OTP)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+18065914974

# SendGrid (Email)
SENDGRID_API_KEY=SG.your_sendgrid_key
SENDGRID_FROM_EMAIL=info@rosshouserentals.com

# Port (Railway sets this automatically)
# PORT=8001
