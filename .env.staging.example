# Ross House backend — isolated staging template
# Copy values into the staging service dashboard. Never use this file for production.

ENVIRONMENT=staging
DISABLE_BACKGROUND_JOBS=true
STAGING_FIXTURES_ENABLED=false
MONGO_URL=mongodb+srv://STAGING_USER:STAGING_PASSWORD@STAGING_CLUSTER/ross_house_staging?retryWrites=true&w=majority
DB_NAME=ross_house_staging

TENANT_JWT_SECRET=replace-with-staging-tenant-jwt-secret
JWT_SECRET_KEY=replace-with-staging-admin-jwt-secret
JWT_SECRET=replace-with-staging-admin-jwt-secret
REFRESH_TOKENS_ENABLED=true
ALLOW_LEGACY_USER_SESSIONS=false
REQUIRE_SESSION_SID=true
REFRESH_DERIVE_KEY=replace-with-staging-refresh-derive-secret
VISITOR_IP_SALT=replace-with-staging-visitor-ip-salt
VAULT_ENCRYPTION_KEY=replace-with-staging-vault-encryption-key

# Helcim is the planned payment provider. Configure its API token and webhook
# verifier through the encrypted admin payment-processor vault, not Railway env.
# Keep every live payment provider disabled during initial staging verification.

# Keep real delivery providers disabled/empty until test recipients are isolated.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=staging@invalid.example
STAGING_EXTERNAL_DELIVERY_ACK=

RENEWAL_TERM_MONTHS=12


# NOAA/NWS Weather Intelligence (open US Government data; no API key)
CLIMATE_WEATHER_ENABLED=false
CLIMATE_WEATHER_CACHE_MINUTES=10
NWS_USER_AGENT=RossHouseRentals/1.0 (https://rosshouserentals.com)

# Independent climate workers.
# Read-only telemetry may run in staging without enabling general background jobs.
CLIMATE_TELEMETRY_ENABLED=false
CLIMATE_TELEMETRY_INTERVAL_SECONDS=300
CLIMATE_READ_RETRY_COUNT=1
CLIMATE_READ_RETRY_DELAY_SECONDS=1
# Automatic schedule execution can write to thermostats and requires explicit opt-in.
CLIMATE_SCHEDULE_WORKER_ENABLED=false
CLIMATE_SCHEDULE_INTERVAL_SECONDS=60
# Legacy compatibility: CLIMATE_MONITOR_ENABLED=true enables telemetry only.

# Staging may collect climate history but must not auto-control thermostats or contact users.
CLIMATE_ALERT_NOTIFICATIONS_ENABLED=false
CLIMATE_ALERT_PUSH_ENABLED=false
